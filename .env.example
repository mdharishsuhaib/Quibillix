# Nebius Token Factory — https://tokenfactory.nebius.com (API keys page)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Tavily — https://app.tavily.com (live fair-price + consumer-law research)
TAVILY_API_KEY=

# NVIDIA Nemotron models used per pipeline step (override if your account lists different IDs;
# run `npm run check-models` to verify)
MODEL_VISION=nvidia/Nemotron-3.5-Super-VL
MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_MID=nvidia/nemotron-3-super-120b-a12b
MODEL_DEEP=nvidia/Nemotron-3-Ultra-550b-a55b

# Requests per IP per hour on the public demo
RATE_LIMIT_PER_HOUR=20
