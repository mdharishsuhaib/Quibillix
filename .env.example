# ---- PRIMARY: Nebius Token Factory (https://tokenfactory.nebius.com → API keys) ----
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NVIDIA Nemotron models per pipeline step on Token Factory (run `npm run check-models` to verify IDs)
MODEL_VISION=nvidia/Nemotron-3.5-Super-VL
MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_MID=nvidia/nemotron-3-super-120b-a12b
MODEL_DEEP=nvidia/Nemotron-3-Ultra-550b-a55b

# ---- FALLBACK: NVIDIA Build (https://build.nvidia.com → Get API key) ----
# Used automatically whenever Nebius is missing, slow or erroring. Same open Nemotron family.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_VISION=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL_MID=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_MODEL_DEEP=nvidia/nemotron-3-ultra-550b-a55b

# ---- Tavily (https://app.tavily.com): live fair-price + consumer-law research ----
TAVILY_API_KEY=

# Requests per IP per hour on the public demo
RATE_LIMIT_PER_HOUR=20

# Optional tuning
# THINK_TIERS=deep               # enable Nemotron reasoning mode per tier
# LLM_TIMEOUT_DEEP_MS=120000     # per-attempt timeout before retry/failover
