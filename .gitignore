# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ============================================================
# SECRETS: never commit any of these
# ============================================================
# env files (API keys: NEBIUS_API_KEY, TAVILY_API_KEY, TAVILY_API_KEY_2, NVIDIA_API_KEY, OLLAMA_API_KEY…)
.env
.env.*
.env*.local
*.env
*.env.*
!.env.example

# keys, certificates & credentials
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
id_rsa*
id_ed25519*
*.ppk
credentials*
*credentials*.json
*secret*
*secrets*
!src/**/*secret*.ts
!scripts/check-secrets.mjs
service-account*.json
*-sa.json
token.json
*.token
api_keys*
apikeys*
keys.json
.npmrc
.netrc
.pypirc

# secret folders
/secrets/
/.secrets/
/private/
/keys/
/.keys/
/credentials/

# deployment / CLI state that can contain tokens
.vercel
.netlify
.wrangler/
.dev.vars
.nebius/
.config/nebius/
.aws/
.gcloud/
.ollama/
.azure/
.docker/config.json
.git-credentials

# local editor / agent state
.cursor/
.idea/
.vscode/*
!.vscode/extensions.json

# local test artefacts (may contain real bill data)
/screenshots/
*.har

# typescript
*.tsbuildinfo
next-env.d.ts

# Taste Skill inspector output
/.taste-skill/
