{
  "name": "quibillix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check-models": "node scripts/check-models.mjs",
    "check-secrets": "node scripts/check-secrets.mjs",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch(e){}\"",
    "smoke": "node scripts/smoke.mjs",
    "test": "tsx scripts/unit.ts && tsx scripts/test-redact.ts",
    "failover-test": "tsx scripts/failover-test.ts",
    "eval": "tsx eval/run.ts",
    "e2e": "tsx scripts/e2e.ts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "deploy": "vinext-cloudflare deploy"
  },
  "engines": {
    "node": ">=22.23"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.3.0",
    "next": "16.4.3",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "^1.0.0-beta.26",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.0"
  },
  "type": "module"
}
